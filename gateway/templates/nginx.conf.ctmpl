events {}

http {


    upstream events_pool {
        {{ range service "events" }}
        server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=30s;
        {{ else }}
        server 127.0.0.1:65535 down;
        {{ end }}
    }

    upstream detection_pool {
        {{ range service "detection" }}
        server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=30s;
        {{ else }}
        server 127.0.0.1:65535 down;
        {{ end }}
    }

    upstream incidents_pool {
        {{ range service "incidents" }}
        server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=30s;
        {{ else }}
        server 127.0.0.1:65535 down;
        {{ end }}
    }

    server {
        listen 8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        location /events {
            proxy_pass http://events_pool;
        }

        location /detection {
            proxy_pass http://detection_pool;
        }

        location /incidents {
            proxy_pass http://incidents_pool;
        }

        location = /heartbeat {
            add_header Content-Type text/plain;
            return 200 "nginx gateway alive";
        }
        
    }
}